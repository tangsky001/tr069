<?xml version="1.0" encoding="UTF-8"?>
<!--
  核心业务日志单独落盘：运行目录/log/ACS_LOG.LOG。
  控制台保留 Spring Boot 默认行为（全部日志、含 CWMP 调试），
  核心事件由 ACS_CORE logger 额外写一份到文件，方便直接翻文件排障。
-->
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- 日志目录：默认进程运行目录下的 log/，可用 -DACS_LOG_DIR=D:\xxx\log 覆盖 -->
    <property name="ACS_LOG_DIR" value="${ACS_LOG_DIR:-log}"/>
    <property name="CORE_FILE" value="${ACS_LOG_DIR}/ACS_LOG.LOG"/>
    <property name="CORE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level - %msg%n"/>

    <appender name="ACS_CORE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${CORE_FILE}</file>
        <!-- 按天 + 20MB 滚动：注意类名要跟 logback 版本对得上，
             1.4.x 用 SizeAndTimeBasedRollingPolicy（1.5 才改名 SizeAndTimeBasedFNATP 之外那套） -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${ACS_LOG_DIR}/ACS_LOG.%d{yyyy-MM-dd}.%i.LOG</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${CORE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 异步写盘：核心日志不能因为磁盘 IO 拖慢 CWMP 处理 -->
    <appender name="ACS_CORE_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="ACS_CORE_FILE"/>
        <queueSize>2048</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <!-- additivity=true：核心事件既进文件也进控制台 -->
    <logger name="ACS_CORE" level="INFO" additivity="true">
        <appender-ref ref="ACS_CORE_ASYNC"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
