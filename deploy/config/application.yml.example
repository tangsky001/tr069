# ==================== 外部化配置模板 ====================
# 用法：把本文件复制为「jar 同级目录/config/application.yml」，再按需修改。
# Spring Boot 加载顺序中，jar 同级 config/ 的优先级高于 jar 内的 application.yml，
# 因此只需在这里写要覆盖的键，未写的继续沿用 jar 内默认值，无需重新打包。
#
# 也可以完全不改文件，用环境变量覆盖：
#   DB_SERVER / DB_PORT / DB_DATABASE / DB_UID / DB_PWD
#   DB_POOL_MIN_IDLE / DB_POOL_MAX_SIZE / DB_MAX_LIFETIME_MS ...

spring:
  datasource:
    # 注意：库表是 utf8mb4，连接串必须用 characterEncoding=utf8mb4。
    # 写成 utf8 会被 MySQL 当成 utf8mb3，遇到 4 字节字符会报 Incorrect string value。
    url: jdbc:mysql://127.0.0.1:3306/tr069?useUnicode=true&characterEncoding=utf8mb4&connectionCollation=utf8mb4_general_ci&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&rewriteBatchedStatements=true&nullCatalogMeansCurrent=true
    username: root
    password:
    hikari:
      minimum-idle: 10
      maximum-pool-size: 50
      connection-timeout: 30000
      # 必须小于 MySQL 的 wait_timeout（默认 28800 秒）
      max-lifetime: 1500000
      idle-timeout: 600000
      leak-detection-threshold: 60000

acs:
  # ACS 对外通告地址，CPE 需能访问，生产环境务必改成真实地址
  public-host: 127.0.0.1

  cwmp:
    # CPE 上报监听端口，可填多个（逗号分隔）。
    # 不同厂商光猫出厂固化的 ACS URL 端口不一致，需要哪个就填哪个，
    # 与主 server.port 重复的会自动跳过。
    listen-ports: 9090,8082
