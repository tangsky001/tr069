<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.tr069</groupId>
    <artifactId>javaacs-server</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>javaacs-server</name>
    <description>TR069 ACS Server - Java 版，功能对齐 Python 版 TR069 ACS</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <jjwt.version>0.12.6</jjwt.version>

        <!-- ============ 前端相关 ============ -->
        <!-- 前端工程目录（vue-admin-template） -->
        <web.dir>${project.basedir}/web</web.dir>
        <!-- 前端构建产物目录，构建后会被复制进 jar 的 BOOT-INF/classes/static -->
        <web.dist.dir>${web.dir}/dist</web.dist.dir>
        <!-- Windows 下 npm 入口为 npm.cmd，Linux/macOS 构建时用 -Dnpm.executable=npm 覆盖 -->
        <npm.executable>npm.cmd</npm.executable>

        <!-- ============ 测试相关 ============ -->
        <!-- 打包默认不跑测试：连 test 源码都不编译，构建日志里也就没有测试输出。
             要跑测试时命令行覆盖：-Dmaven.test.skip=false -->
        <maven.test.skip>true</maven.test.skip>
        <!-- 只跳过执行、仍编译测试类时用：-DskipTests=false（与上面二选一，命令行给） -->
        <skipTests>true</skipTests>
    </properties>

    <!--
        国内网络下 central 拉包慢且容易超时，改用阿里云公共仓库。
        注意：这里只是「追加」仓库，Maven 从超级 POM 继承的 central 依然在，
        阿里云缺失的构件会自动回落到 central，不会把构建锁死在单一源。
    -->
    <repositories>
        <repository>
            <id>aliyun-public</id>
            <name>aliyun public</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>aliyun-spring</id>
            <name>aliyun spring</name>
            <url>https://maven.aliyun.com/repository/spring</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>aliyun-public</id>
            <name>aliyun public</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>aliyun-spring-plugin</id>
            <name>aliyun spring plugin</name>
            <url>https://maven.aliyun.com/repository/spring-plugin</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <dependencies>
        <!-- ==================== Web ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- 上报与下发队列：设备高峰上报削峰，指令不再堆积在内存 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ==================== 持久化 ==================== -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- MySQL 驱动仅作为运行期依赖，数据库本身部署在 jar 外部 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== 安全 (管理端 JWT) ==================== -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== 工具 ==================== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ==================== 模板库：光猫已适配数据，便携化单文件 SQLite ==================== -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.0</version>
        </dependency>

        <!-- ==================== 测试 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>javaacs-server</finalName>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <!--
                全库只有一份建表脚本：根目录 sql/schema.sql。
                这里复制到 classpath:db/schema.sql，供各模块的自动补表组件读取，
                避免仓库里出现两份同名表的定义（副本必然漂移）。
            -->
            <resource>
                <directory>${project.basedir}/sql</directory>
                <targetPath>db</targetPath>
                <includes>
                    <include>schema.sql</include>
                    <include>schema-tr069tpl.sql</include>
                </includes>
                <filtering>false</filtering>
            </resource>
        </resources>

        <plugins>
            <!--
                把前端 dist 打进 jar。
                默认构建只做「拷贝已有 dist」；若 dist 不存在会 WARN 跳过，不阻塞后端打包。
                需要先现场构建前端时，使用 -Pweb 激活构建。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
                <executions>

                    <execution>
                        <id>copy-configuration-to-target</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/configuration</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/configuration</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-web-dist-into-classes</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${web.dist.dir}</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            现场构建前端并打进 jar：
                mvn clean package -Pweb
            Linux / macOS：
                mvn clean package -Pweb -Dnpm.executable=npm
        -->
        <profile>
            <id>web</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>npm-install</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <workingDirectory>${web.dir}</workingDirectory>
                                    <executable>${npm.executable}</executable>
                                    <arguments>
                                        <argument>install</argument>
                                        <argument>--legacy-peer-deps</argument>
                                        <argument>--no-audit</argument>
                                        <argument>--no-fund</argument>
                                    </arguments>
                                    <!-- 旧版 webpack 在 OpenSSL3 下需要 legacy provider -->
                                    <environmentVariables>
                                        <NODE_OPTIONS>--openssl-legacy-provider</NODE_OPTIONS>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm-build-dist</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <workingDirectory>${web.dir}</workingDirectory>
                                    <executable>${npm.executable}</executable>
                                    <arguments>
                                        <argument>run</argument>
                                        <argument>build:prod</argument>
                                    </arguments>
                                    <environmentVariables>
                                        <NODE_OPTIONS>--openssl-legacy-provider</NODE_OPTIONS>
                                        <NODE_ENV>production</NODE_ENV>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
