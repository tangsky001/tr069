# ==================== PilotACS 部署参数 ====================
# 复制为 .env 后按需修改：cp .env.example .env

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=PilotACS@123
MYSQL_DATABASE=tr_acs
MYSQL_PORT=3306

# ---------- ACS 对外地址 ----------
# 光猫要回连的地址（下发给设备的 ACS URL 会拼它），生产环境务必改成真实地址
ACS_PUBLIC_HOST=127.0.0.1

# ---------- 端口 ----------
APP_PORT=8888
OPENAPI_PORT=8899

# 光猫 CWMP 上报监听端口，按厂商出厂固化值，一般不用改
ACS_CWMP_LISTEN_PORTS=9090,8082,6060,8012,8080,8172,5481

# ---------- JVM ----------
JAVA_OPTS=-Xms512m -Xmx1024m
